# Copy to .env and adjust. The experiment runs with no .env at all —
# every setting below has a working default.
#
#   cp .env.example .env

# Flask
FLASK_APP=app.py
FLASK_ENV=development

# Session signing key. Any non-empty string works for local replication;
# set a random value if you deploy this publicly.
FLASK_SECRET_KEY=dev-secret-not-for-production

# ---------------------------------------------------------------------------
# Response storage
# ---------------------------------------------------------------------------
# local  (default) — write one CSV per participant to RESPONSE_DIR.
#                    This is what you want for replication.
# s3              — upload to the original study's S3 buckets. Requires the
#                    credentials below and access to those buckets, which are
#                    private to the original authors.
RESPONSE_STORAGE=local

# Where local responses are written (default: <repo>/data/responses)
# RESPONSE_DIR=/absolute/path/to/output

# Only required when RESPONSE_STORAGE=s3
# AccessKey=
# SecreteAccessKey=
# TaskBucket=string-experiment
# SurveyBucket=string-experiment-post
